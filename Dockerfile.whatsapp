FROM golang:1.24.1-bookworm AS builder
WORKDIR /src
COPY upstream/whatsapp-mcp/whatsapp-bridge/go.mod upstream/whatsapp-mcp/whatsapp-bridge/go.sum ./
RUN go mod download
COPY upstream/whatsapp-mcp/whatsapp-bridge/main.go ./main.go
RUN CGO_ENABLED=1 go build -o /out/whatsapp-bridge ./main.go

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/whatsapp-bridge /usr/local/bin/whatsapp-bridge
VOLUME ["/app/store"]
EXPOSE 8080
CMD ["whatsapp-bridge"]
