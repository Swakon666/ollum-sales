# MCP network
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Production publishes this port on 127.0.0.1 only for the host reverse proxy.
OLLUM_MCP_BIND_PORT=18000

# Production must enable auth and provide a long random bearer token.
OLLUM_MCP_REQUIRE_AUTH=false
OLLUM_MCP_BEARER_TOKEN=

# ScrapeGraphAI / LLM
# Example hosted model. Override with whichever ScrapeGraphAI-supported provider/model you use.
SCRAPEGRAPH_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# Generic override for non-OpenAI hosted providers if needed by your selected model.
LLM_API_KEY=
# Optional reliable market discovery provider: https://serper.dev
SERPER_API_KEY=

# Persistent sales CRM and bounded public-web discovery/inspection.
# Docker Compose overrides the CRM path to a dedicated named volume.
OLLUM_CRM_DB_PATH=./data/ollum-sales.db
OLLUM_COMPANY_SEARCH_TIMEOUT=20
OLLUM_WEBSITE_INSPECTION_TIMEOUT=20

# WhatsApp bridge — local-development defaults.
# Docker Compose overrides both values automatically for container networking/shared storage.
WHATSAPP_API_BASE_URL=http://localhost:8080/api
WHATSAPP_MESSAGES_DB_PATH=./upstream/whatsapp-mcp/whatsapp-bridge/store/messages.db

# Safe default: read-only WhatsApp. Change to true only when ready to allow sends.
OLLUM_ALLOW_WHATSAPP_SEND=false

# Autopilot. SAFE prepares grounded analyses and drafts but never sends.
OLLUM_AUTOPILOT_DEFAULT_MODE=safe
OLLUM_AUTOPILOT_INTERVAL_MINUTES=60
OLLUM_AUTOPILOT_MAX_VERTICALS_PER_CYCLE=2
OLLUM_AUTOPILOT_LEADS_PER_VERTICAL=10
OLLUM_AUTOPILOT_SCORE_THRESHOLD=65
OLLUM_AUTOPILOT_MIN_TRAINING_LEADS=100
# Non-SAFE modes require this flag, WhatsApp sending, enough training leads,
# and an explicit start confirmation. Keep false during the initial rollout.
OLLUM_AUTOPILOT_ALLOW_SEND=false

# Google Sheets live panel. Share the spreadsheet with the service-account email.
# Never commit the service-account JSON file.
OLLUM_GOOGLE_SHEETS_ENABLED=false
OLLUM_GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/ollum-google-service-account.json
