# MCP network
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Production publishes this port on 127.0.0.1 only for the host reverse proxy.
OLLUM_MCP_BIND_PORT=18000

# Legacy service-to-service bearer mode. Existing deployments remain compatible.
OLLUM_AUTH_MODE=bearer
OLLUM_MCP_REQUIRE_AUTH=false
OLLUM_MCP_BEARER_TOKEN=

# Closed-beta web panel + ChatGPT MCP plugin (OAuth 2.1/OIDC, PKCE handled by clients).
# Switch OLLUM_AUTH_MODE to oidc only after every value below is configured.
OLLUM_PUBLIC_BASE_URL=
# Optional separate cabinet/API origin, for example https://api.ollumgroup.ru.
# Browser-facing dashboard origin. Falls back to OLLUM_PUBLIC_BASE_URL.
OLLUM_DASHBOARD_BASE_URL=
# OAuth callback origin. Set this separately when the provider only allows the MCP host.
OLLUM_OIDC_REDIRECT_BASE_URL=
OLLUM_MCP_RESOURCE_URL=
OLLUM_MCP_REQUIRED_SCOPES=sales:read,sales:write
# ChatGPT-compatible OAuth authorization server and dynamic client registration.
# Keep disabled until the dashboard OAuth login and a persistent storage secret are set.
OLLUM_OAUTH_DCR_ENABLED=false
# Generate at least 32 random bytes; encrypts registered OAuth client credentials at rest.
OLLUM_OAUTH_STORAGE_SECRET=
OLLUM_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com
OLLUM_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OLLUM_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OLLUM_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
OLLUM_OIDC_ISSUER_URL=
OLLUM_OIDC_AUDIENCE=
# Optional. Defaults to <issuer>/.well-known/jwks.json.
OLLUM_OIDC_JWKS_URL=
OLLUM_OIDC_ALGORITHMS=RS256
# Optional subject-level beta allowlist in addition to the dashboard email allowlist.
OLLUM_OIDC_ALLOWED_SUBJECTS=

OLLUM_ADMIN_ENABLED=false
OLLUM_ADMIN_OIDC_CLIENT_ID=
OLLUM_ADMIN_OIDC_CLIENT_SECRET=
OLLUM_ADMIN_ALLOWED_EMAILS=
OLLUM_ADMIN_READ_SCOPE=sales:read
OLLUM_ADMIN_WRITE_SCOPE=sales:write
# Generate at least 32 random bytes; never commit the value.
OLLUM_ADMIN_SESSION_SECRET=
OLLUM_ADMIN_SESSION_MAX_AGE_SECONDS=28800
OLLUM_DEFAULT_WORKSPACE_ID=ollum-group
OLLUM_DEFAULT_WORKSPACE_NAME=Ollum Group
# Optional comma-separated owner emails. The first bootstrap account is always owner.
OLLUM_WORKSPACE_OWNER_EMAILS=

# ChatGPT is the only reasoning engine. The server synchronizes and validates MCP work;
# it has no OpenAI/LLM API key and never generates a reply itself.
OLLUM_CONVERSATION_AGENT_ENABLED=true
OLLUM_CONVERSATION_AGENT_POLL_SECONDS=900
OLLUM_CONVERSATION_AGENT_BATCH_SIZE=3
# Optional reliable market discovery provider: https://serper.dev
SERPER_API_KEY=

# Persistent sales CRM and bounded public-web discovery/inspection.
# Docker Compose overrides the CRM path to a dedicated named volume.
OLLUM_CRM_DB_PATH=./data/ollum-sales.db
OLLUM_COMPANY_SEARCH_TIMEOUT=20
OLLUM_WEBSITE_INSPECTION_TIMEOUT=20
OLLUM_EVIDENCE_TTL_HOURS=168
OLLUM_RETRY_ATTEMPTS=3
OLLUM_RETRY_BASE_DELAY_SECONDS=0.5

# WhatsApp bridge — local-development defaults.
# Docker Compose overrides both values automatically for container networking/shared storage.
WHATSAPP_API_BASE_URL=http://localhost:8080/api
WHATSAPP_PROXY_URL=
WHATSAPP_PAIRING_TIMEOUT=10m
WHATSAPP_MESSAGES_DB_PATH=./upstream/whatsapp-mcp/whatsapp-bridge/store/messages.db

# Safe default: read-only WhatsApp. Change to true only when ready to allow sends.
OLLUM_ALLOW_WHATSAPP_SEND=false
# Optional comma-separated exact recipients for isolated, text-only closed-beta tests.
# This does not enable global or Autopilot sending and still requires an approved saved draft.
OLLUM_WHATSAPP_TEST_RECIPIENTS=

# Autopilot. SAFE prepares grounded analyses and drafts but never sends.
OLLUM_AUTOPILOT_DEFAULT_MODE=safe
OLLUM_AUTOPILOT_INTERVAL_MINUTES=60
OLLUM_AUTOPILOT_MAX_VERTICALS_PER_CYCLE=2
OLLUM_AUTOPILOT_LEADS_PER_VERTICAL=10
OLLUM_AUTOPILOT_SCORE_THRESHOLD=65
OLLUM_AUTOPILOT_MIN_TRAINING_LEADS=100
# Non-SAFE modes require this flag, WhatsApp sending, enough training leads,
# and an explicit start confirmation. Keep false during the initial rollout.
OLLUM_AUTOPILOT_ALLOW_SEND=false

# Google Sheets live panel. Share the spreadsheet with the service-account email.
# Never commit the service-account JSON file.
OLLUM_GOOGLE_SHEETS_ENABLED=false
OLLUM_GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/ollum-google-service-account.json
